#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
BUILD_DIR="${BUILD_DIR:-${PROJECT_DIR}/build}"
if [[ "${BUILD_DIR}" != /* ]]; then
    BUILD_DIR="${PROJECT_DIR}/${BUILD_DIR}"
fi
TESTS="${BUILD_DIR}/ReceiptReaderTests"

if [[ ! -x "${TESTS}" ]]; then
    echo "ReceiptReaderTests is not built. Run ${SCRIPT_DIR}/build first." >&2
    exit 1
fi

cd "${PROJECT_DIR}"
"${TESTS}" "$@"
