    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "openapi-typescript": "^7.6.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^3.3.14"
  }
}
